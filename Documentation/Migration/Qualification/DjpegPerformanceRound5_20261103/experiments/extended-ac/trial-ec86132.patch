index 0000000..cdc22ad
--- /dev/null
+++ b/Sources/SwiftJLI/Native/Entropy/ExtendedACLookahead.swift
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: Apache-2.0
+
+/// Pipeline-local AC lookup. Complete short values keep the original encoding.
+/// Bit31 marks a short Huffman code whose magnitude exceeds the13-bit prefix;
+/// its low byte stores the category for extraction from the existing accumulator.
+/// Every entry remains32 bits, so the fixed lookup reservation is unchanged.
+struct ExtendedACLookahead {
+    static let bits = 13
+    static let count = 1 << bits
+    let entries: [UInt32]
+
+    init?(table: HuffmanTable, blockCount: Int) {
+        // Amortise construction over a substantial plane. At most three active
+        // component tables occupy 96 KiB of the decoder's 1 MiB scratch reserve.
+        guard blockCount >= 512 else { return nil }
+        var covered = 0, hasCoveredMagnitude = false
+        for prefix in 0..<256 {
+            let length = Int(table.lookaheadLength[prefix])
+            let category = Int(table.lookaheadSymbol[prefix] & 0x0F)
+            if length > 0, length + category <= Self.bits {
+                covered += 1
+                hasCoveredMagnitude = hasCoveredMagnitude || category > 0
+            }
+        }
+        // EOB/ZRL-only tables already have a cheap symbol path. Their flat
+        // planes cannot amortise building a combined magnitude lookup.
+        guard covered >= 128, hasCoveredMagnitude else { return nil }
+        var entries = [UInt32](repeating: 0, count: Self.count)
+        for prefix in 0..<Self.count {
+            let shortPrefix = prefix >> (Self.bits - 8)
+            let length = Int(table.lookaheadLength[shortPrefix])
+            guard length > 0 else { continue }
+            let symbol = table.lookaheadSymbol[shortPrefix]
+            let category = Int(symbol & 0x0F), consumed = length + category
+            if consumed > Self.bits {
+                let advance = Int(symbol >> 4) + 1
+                entries[prefix] = 0x8000_0000 | (UInt32(consumed) << 24)
+                    | (UInt32(advance) << 16) | UInt32(category)
+                continue
+            }
+            let value: Int
+            if category == 0 { value = 0 }
+            else {
+                let magnitude = (prefix >> (Self.bits - consumed)) & ((1 << category) - 1)
+                value = magnitude < (1 << (category - 1))
+                    ? magnitude - ((1 << category) - 1) : magnitude
+            }
+            let advance = symbol == 0 ? 0 : Int(symbol >> 4) + 1
+            entries[prefix] = (UInt32(consumed) << 24) | (UInt32(advance) << 16)
+                | UInt32(UInt16(truncatingIfNeeded: value))
+        }
+        self.entries = entries
+    }
+}
+
+
+extension HuffmanDecoder {
+    /// Uncovered codes and boundary cases retain the ordinary decoder below.
+    static func decodeExtendedAC(
+        from reader: inout BitReader, table: HuffmanTable, lookup: ExtendedACLookahead,
+        into output: UnsafeMutableBufferPointer<Int32>
+    ) throws {
+        guard output.count == 64, let coefficients = output.baseAddress else {
+            throw JLIError.decodingFailed("Invalid AC coefficient destination")
+        }
+        coefficients.update(repeating: 0, count: 64)
+        var index = 1
+        while index < 64 {
+            if let entry = reader.fastDecodeExtendedAC(lookup, remaining: 64 - index) {
+                let advance = Int((entry >> 16) & 0xFF)
+                if advance == 0 { break }
+                index += advance
+                coefficients[index - 1] = Int32(Int16(truncatingIfNeeded: entry))
+                continue
+            }
+            let symbol = try decodeSymbol(from: &reader, table: table)
+            if symbol == 0x00 { break }
+            if symbol == 0xF0 {
+                index += 16
+                continue
+            }
+            index += Int(symbol >> 4)
+            guard index < 64 else { break }
+            coefficients[index] = try decodeValue(from: &reader, category: Int(symbol & 0x0F))
+            index += 1
+        }
+    }
+}
