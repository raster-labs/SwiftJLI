--- a/Sources/SwiftJLI/Native/Entropy/JLIBitStream.swift
+++ b/Sources/SwiftJLI/Native/Entropy/JLIBitStream.swift
@@ -336,6 +336,29 @@ struct BitReader {
         return entry
     }
 
+    /// The extension consumes a long magnitude only when its entire short-code
+    /// and value are already buffered. A boundary/overflow miss consumes nothing.
+    @inline(__always)
+    mutating func fastDecodeExtendedAC(_ table: ExtendedACLookahead, remaining: Int) -> UInt32? {
+        if bitsAvailable < ExtendedACLookahead.bits, !bulkRefill() { fillBuffer(upTo: 8) }
+        guard bitsAvailable >= ExtendedACLookahead.bits else { return nil }
+        let prefix = Int((bitBuffer &>> (bitsAvailable - ExtendedACLookahead.bits)) & UInt64(ExtendedACLookahead.count - 1))
+        let entry = table.entries[prefix]
+        guard entry != 0, Int((entry >> 16) & 0xFF) <= remaining else { return nil }
+        if entry & 0x8000_0000 == 0 {
+            bitsAvailable -= Int(entry >> 24)
+            return entry
+        }
+        let consumed = Int((entry >> 24) & 0x7F)
+        guard bitsAvailable >= consumed else { return nil }
+        let category = Int(entry & 15)
+        bitsAvailable -= consumed
+        let mask = (UInt64(1) &<< category) - 1
+        let magnitude = Int32((bitBuffer &>> bitsAvailable) & mask)
+        let value = magnitude < (1 &<< (category - 1)) ? magnitude - Int32(mask) : magnitude
+        return (entry & 0x7FFF_0000) | UInt32(UInt16(truncatingIfNeeded: value))
+    }
+
     /// Best-effort buffer fill used by the Huffman lookahead paths. Tries the
     /// bulk splice first, then loads whole bytes (resolving `0xFF 0x00` stuffing
     /// exactly as ``loadByte()`` does) until at least `target` bits are buffered,
diff --git a/Tests/SwiftJLITests/Native/ExtendedACLookaheadTests.swift b/Tests/SwiftJLITests/Native/ExtendedACLookaheadTests.swift
new file mode 100644
index 0000000..a1d4bf5
--- /dev/null
+++ b/Tests/SwiftJLITests/Native/ExtendedACLookaheadTests.swift
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: Apache-2.0
+import Testing
+@testable import SwiftJLI
+
+@Suite struct ExtendedACLookaheadTests {
+    private func reference(_ reader: inout BitReader, _ table: HuffmanTable,
+                           remaining: Int) throws -> (Int, Int32) {
+        let symbol = try HuffmanDecoder.decodeSymbol(from: &reader, table: table)
+        if symbol == 0 { return (0, 0) }
+        if symbol == 0xF0 { return (16, 0) }
+        let advance = Int(symbol >> 4) + 1
+        // The old decoder stops after a run overflow, without reading magnitude.
+        guard advance <= remaining else { return (advance, 0) }
+        return (advance, try HuffmanDecoder.decodeValue(from: &reader, category: Int(symbol & 15)))
+    }
+
+    @Test func allocationAndCoverageDispatchAreBounded() throws {
+        #expect(ExtendedACLookahead(table: StandardHuffmanTables.acLuminance, blockCount: 511) == nil)
+        let lookup = try #require(ExtendedACLookahead(table: StandardHuffmanTables.acLuminance, blockCount: 512))
+        #expect(lookup.entries.count * MemoryLayout<UInt32>.size == 32768)
+        let long = HuffmanTable(bits: [1] + Array(repeating: 0, count: 15), values: [0x0F])
+        #expect(ExtendedACLookahead(table: long, blockCount: 65536) == nil)
+        let flat = HuffmanTable(bits: [1] + Array(repeating: 0, count: 15), values: [0])
+        #expect(ExtendedACLookahead(table: flat, blockCount: 65536) == nil)
+        let zeros = HuffmanTable(bits: [1, 1] + Array(repeating: 0, count: 14), values: [0, 0xF0])
+        #expect(ExtendedACLookahead(table: zeros, blockCount: 65536) == nil)
+    }
+
+    @Test func everyPrefixOffsetAndRunBoundaryMatchesReference() throws {
+        let tables = [StandardHuffmanTables.acLuminance, StandardHuffmanTables.acChrominance,
+            HuffmanTable(bits: [0, 0, 0, 15] + Array(repeating: 0, count: 12),
+                values: (0..<13).map { UInt8($0 << 4) } + [0x01, 0xF0])]
+        for table in tables {
+            let lookup = try #require(ExtendedACLookahead(table: table, blockCount: 512))
+            var hits = 0, misses = 0
+            for offset in 0..<8 { for prefix in 0..<ExtendedACLookahead.count {
+                let remaining = prefix % 63 + 1
+                var writer = BitWriter(estimatedMaxSize: 32)
+                writer.writeBits(0, count: offset)
+                writer.writeBits(UInt32(prefix), count: ExtendedACLookahead.bits)
+                for tail in [UInt32(0xA55A), 0x1234, 0x6789, 0x90AB] {
+                    writer.writeBits(tail, count: 16)
+                }
+                writer.flush()
+                var fast = BitReader(data: writer.data), slow = BitReader(data: writer.data)
+                _ = try fast.readBits(offset); _ = try slow.readBits(offset)
+                let expected = Result { try reference(&slow, table, remaining: remaining) }
+                let actual = Result {
+                    if let entry = fast.fastDecodeExtendedAC(lookup, remaining: remaining) {
+                        hits += 1
+                        return (Int((entry >> 16) & 0xFF), Int32(Int16(truncatingIfNeeded: entry)))
+                    }
+                    misses += 1
+                    return try reference(&fast, table, remaining: remaining)
+                }
+                switch (expected, actual) {
+                case (.success(let lhs), .success(let rhs)):
+                    #expect(lhs.0 == rhs.0 && lhs.1 == rhs.1)
+                    #expect(fast.byteOffset == slow.byteOffset)
+                    #expect(try fast.readBits(16) == slow.readBits(16))
+                case (.failure(let lhs), .failure(let rhs)):
+                    #expect(String(describing: lhs) == String(describing: rhs))
+                default: Issue.record("Combined AC lookup differs from reference")
+                }
+            } }
+            #expect(hits > 0 && misses > 0)
+        }
+    }
+
+    @Test func widerPrefetchPreservesLogicalCursorAndMarkerBoundaries() throws {
+        let table = StandardHuffmanTables.acLuminance
+        let lookup = try #require(ExtendedACLookahead(table: table, blockCount: 512))
+        let tails: [[UInt8]] = [Array(repeating: 0xAA, count: 24), [], [0xFF],
+            [0xFF, 0], [0xFF, 0xD0], [0xFF, 0xD9],
+            [0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xFF, 0, 0xFF, 0xD0]]
+        for available in 8...12 { for (tailIndex, tail) in tails.enumerated() {
+            var fast = BitReader(data: Array(repeating: 0xAA, count: 8) + tail)
+            var referenceReader = fast
+            var consume = 64 - available
+            while consume > 0 {
+                let width = min(consume, 16)
+                #expect(try fast.readBits(width) == referenceReader.readBits(width))
+                consume -= width
+            }
+            let expected = try reference(&referenceReader, table, remaining: 63)
+            let actual: (Int, Int32)
+            if let entry = fast.fastDecodeExtendedAC(lookup, remaining: 63) {
+                actual = (Int((entry >> 16) & 0xFF), Int32(Int16(truncatingIfNeeded: entry)))
+            } else {
+                actual = try reference(&fast, table, remaining: 63)
+            }
+            #expect(actual.0 == expected.0 && actual.1 == expected.1)
+            if tailIndex == 0 {
+                // This case proves that the additional FF-free prefetch ran.
+                #expect(fast.byteOffset > referenceReader.byteOffset)
+            } else {
+                // A short or FF-containing next word must not be prefetched.
+                #expect(fast.byteOffset == referenceReader.byteOffset)
+            }
+            var fastAligned = fast, referenceAligned = referenceReader
+            fastAligned.alignToByte(); referenceAligned.alignToByte()
+            #expect(fastAligned.byteOffset == referenceAligned.byteOffset)
+            let nextFast = Result { try fast.readBits(16) }
+            let nextReference = Result { try referenceReader.readBits(16) }
+            switch (nextFast, nextReference) {
+            case (.success(let a), .success(let b)): #expect(a == b)
+            case (.failure(let a), .failure(let b)):
+                #expect(String(describing: a) == String(describing: b))
+            default: Issue.record("AC prefetch changed remaining entropy or its error")
+            }
+        } }
+    }
+
+    @Test func fullBlocksAndPartialErrorsPreserveCoefficientsAndLogicalCursor() throws {
+        let table = StandardHuffmanTables.acLuminance
+        let pairs = try #require(ExtendedACLookahead(table: table, blockCount: 2048))
+        for prefix in stride(from: 0, to: 8192, by: 7) {
+            var writer = BitWriter(estimatedMaxSize: 128)
+            writer.writeBits(UInt32(prefix), count: 13)
+            for word in 0..<32 { writer.writeBits(UInt32((word * 8191 + prefix) & 65535), count: 16) }
+            writer.flush()
+            for length in [1, 2, 7, writer.data.count] {
+                var actual = BitReader(data: Array(writer.data.prefix(length))), reference = actual
+                var result = [Int32](repeating: 123456, count: 64), expected = result
+                let a = Result { try result.withUnsafeMutableBufferPointer {
+                    try HuffmanDecoder.decodeExtendedAC(from: &actual, table: table, lookup: pairs, into: $0)
+                } }
+                let b = Result { try expected.withUnsafeMutableBufferPointer {
+                    try HuffmanDecoder.decodeAC(from: &reference, table: table, into: $0)
+                } }
+                switch (a, b) {
+                case (.success, .success): break
+                case (.failure(let x), .failure(let y)): #expect(String(describing: x) == String(describing: y))
+                default: Issue.record("Extended lookup changed block or failure completion")
+                }
+                #expect(result == expected)
+                actual.alignToByte(); reference.alignToByte()
+                #expect(actual.byteOffset == reference.byteOffset)
+            }
+        }
+    }
+}
