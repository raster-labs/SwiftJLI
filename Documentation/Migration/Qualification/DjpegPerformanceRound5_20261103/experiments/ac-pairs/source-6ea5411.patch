diff --git a/Sources/SwiftJLI/Native/Entropy/ACPairLookahead.swift b/Sources/SwiftJLI/Native/Entropy/ACPairLookahead.swift
new file mode 100644
index 0000000..0c896df
--- /dev/null
+++ b/Sources/SwiftJLI/Native/Entropy/ACPairLookahead.swift
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: Apache-2.0
+
+/// Two independent short run/value entries within the same 13 buffered bits.
+/// A missing second entry retains the ordinary single-entry result. Construction
+/// is limited to a single-component pipeline; other decoders keep their tables.
+struct ACPairLookahead {
+    let entries: [UInt64]
+
+    init?(table: HuffmanTable, blockCount: Int) {
+        guard blockCount >= 2048, let single = ACLookahead(table: table, blockCount: blockCount) else { return nil }
+        var entries = [UInt64](repeating: 0, count: ACLookahead.count)
+        for prefix in 0..<ACLookahead.count {
+            let first = single.entries[prefix]
+            guard first != 0 else { continue }
+            entries[prefix] = UInt64(first)
+            let available = ACLookahead.bits - Int(first >> 24)
+            guard available > 0, (first >> 16) & 0xFF != 0 else { continue }
+            // Padding the unconsumed suffix cannot change a complete canonical
+            // prefix. Accept it only if its entire code and magnitude fit.
+            let secondPrefix = (prefix & ((1 << available) - 1)) << (ACLookahead.bits - available)
+            let second = single.entries[secondPrefix]
+            if second != 0, Int(second >> 24) <= available {
+                entries[prefix] |= UInt64(second) << 32
+            }
+        }
+        self.entries = entries
+    }
+}
+
+extension HuffmanDecoder {
+    /// Every coefficient is cleared before consumption, including partial-error
+    /// exits. The pair reader handles end-of-block/run boundaries before reading
+    /// a second entry, so no symbol from the next block is consumed here.
+    static func decodeACPairs(from reader: inout BitReader, table: HuffmanTable,
+                              lookup: ACPairLookahead, into output: UnsafeMutableBufferPointer<Int32>) throws {
+        guard output.count == 64, let coefficients = output.baseAddress else {
+            throw JLIError.decodingFailed("Invalid AC coefficient destination")
+        }
+        coefficients.update(repeating: 0, count: 64)
+        var index = 1
+        while index < 64 {
+            if let pair = reader.fastDecodeACPair(lookup, remaining: 64 - index) {
+                let first = UInt32(truncatingIfNeeded: pair)
+                let advance = Int((first >> 16) & 0xFF)
+                if advance == 0 { break }
+                index += advance
+                coefficients[index - 1] = Int32(Int16(truncatingIfNeeded: first))
+                let second = UInt32(truncatingIfNeeded: pair >> 32)
+                if second != 0 {
+                    let advance = Int((second >> 16) & 0xFF)
+                    if advance == 0 { break }
+                    index += advance
+                    coefficients[index - 1] = Int32(Int16(truncatingIfNeeded: second))
+                }
+                continue
+            }
+            let symbol = try decodeSymbol(from: &reader, table: table)
+            if symbol == 0 { break }
+            if symbol == 0xF0 { index += 16; continue }
+            index += Int(symbol >> 4)
+            guard index < 64 else { break }
+            coefficients[index] = try decodeValue(from: &reader, category: Int(symbol & 15))
+            index += 1
+        }
+    }
+}
