@@ -336,6 +336,29 @@ struct BitReader {
         return entry
     }
 
+    /// Consume at most two complete AC entries without crossing a block/run
+    /// boundary. A first-entry run overflow retains the throwing fallback's
+    /// original symbol-only consumption. Physical prefetch obeys fastDecodeAC.
+    @inline(__always)
+    mutating func fastDecodeACPair(_ table: ACPairLookahead, remaining: Int) -> UInt64? {
+        if bitsAvailable < ACLookahead.bits, !bulkRefill() { fillBuffer(upTo: 8) }
+        guard bitsAvailable >= ACLookahead.bits else { return nil }
+        let prefix = Int((bitBuffer &>> (bitsAvailable - ACLookahead.bits)) & UInt64(ACLookahead.count - 1))
+        let pair = table.entries[prefix], first = UInt32(truncatingIfNeeded: pair)
+        let advance = Int((first >> 16) & 0xFF)
+        guard first != 0, advance <= remaining else { return nil }
+        var consumed = Int(first >> 24)
+        let second = UInt32(truncatingIfNeeded: pair >> 32)
+        if second != 0, advance > 0, advance < remaining,
+           Int((second >> 16) & 0xFF) <= remaining - advance {
+            consumed += Int(second >> 24)
+            bitsAvailable -= consumed
+            return pair
+        }
+        bitsAvailable -= consumed
+        return UInt64(first)
+    }
