diff --git a/Tests/SwiftJLITests/Native/ACPairLookaheadTests.swift b/Tests/SwiftJLITests/Native/ACPairLookaheadTests.swift
new file mode 100644
index 0000000..db41fd0
--- /dev/null
+++ b/Tests/SwiftJLITests/Native/ACPairLookaheadTests.swift
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: Apache-2.0
+import Testing
+@testable import SwiftJLI
+
+@Suite struct ACPairLookaheadTests {
+    @Test func allPrefixesOffsetsAndBlockEdgesMatchSingleEntryReference() throws {
+        for table in [StandardHuffmanTables.acLuminance, StandardHuffmanTables.acChrominance] {
+            let pairs = try #require(ACPairLookahead(table: table, blockCount: 2048))
+            let single = try #require(ACLookahead(table: table, blockCount: 2048))
+            #expect(pairs.entries.count * MemoryLayout<UInt64>.stride == 65_536)
+            var twoEntries = 0
+            for offset in 0..<8 { for prefix in 0..<ACLookahead.count {
+                var writer = BitWriter(estimatedMaxSize: 32)
+                writer.writeBits(0, count: offset)
+                writer.writeBits(UInt32(prefix), count: 13)
+                for word in [UInt32(0xA55A), 0x1234, 0xFEDC, 0x90AB] { writer.writeBits(word, count: 16) }
+                writer.flush()
+                var actual = BitReader(data: writer.data), reference = actual
+                _ = try actual.readBits(offset); _ = try reference.readBits(offset)
+                let remaining = prefix % 63 + 1
+                if let pair = actual.fastDecodeACPair(pairs, remaining: remaining) {
+                    let first = try #require(reference.fastDecodeAC(single, remaining: remaining))
+                    #expect(UInt32(truncatingIfNeeded: pair) == first)
+                    let second = UInt32(truncatingIfNeeded: pair >> 32)
+                    if second != 0 {
+                        let advance = Int((first >> 16) & 255)
+                        #expect(advance > 0 && advance < remaining)
+                        #expect(reference.fastDecodeAC(single, remaining: remaining - advance) == second)
+                        twoEntries += 1
+                    }
+                    #expect(try actual.readBits(16) == reference.readBits(16))
+                    actual.alignToByte(); reference.alignToByte()
+                    #expect(actual.byteOffset == reference.byteOffset)
+                } else {
+                    #expect(reference.fastDecodeAC(single, remaining: remaining) == nil)
+                    #expect(try actual.readBits(16) == reference.readBits(16))
+                }
+            } }
+            #expect(twoEntries > 0)
+        }
+    }
+
+    @Test func fullBlocksAndPartialErrorsPreserveCoefficientsAndLogicalCursor() throws {
+        let table = StandardHuffmanTables.acLuminance
+        let pairs = try #require(ACPairLookahead(table: table, blockCount: 2048))
+        for prefix in stride(from: 0, to: 8192, by: 7) {
+            var writer = BitWriter(estimatedMaxSize: 128)
+            writer.writeBits(UInt32(prefix), count: 13)
+            for word in 0..<32 { writer.writeBits(UInt32((word * 8191 + prefix) & 65535), count: 16) }
+            writer.flush()
+            for length in [1, 2, 7, writer.data.count] {
+                var actual = BitReader(data: Array(writer.data.prefix(length))), reference = actual
+                var result = [Int32](repeating: 123456, count: 64), expected = result
+                let a = Result { try result.withUnsafeMutableBufferPointer {
+                    try HuffmanDecoder.decodeACPairs(from: &actual, table: table, lookup: pairs, into: $0)
+                } }
+                let b = Result { try expected.withUnsafeMutableBufferPointer {
+                    try HuffmanDecoder.decodeAC(from: &reference, table: table, into: $0)
+                } }
+                switch (a, b) {
+                case (.success, .success): break
+                case (.failure(let x), .failure(let y)): #expect(String(describing: x) == String(describing: y))
+                default: Issue.record("Pair lookup changed block or failure completion")
+                }
+                #expect(result == expected)
+                actual.alignToByte(); reference.alignToByte()
+                #expect(actual.byteOffset == reference.byteOffset)
+            }
+        }
+    }
+}
