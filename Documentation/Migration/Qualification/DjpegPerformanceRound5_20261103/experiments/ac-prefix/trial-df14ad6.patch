+    @Test func partialPlainPrefixesNeverConsumeStuffingOrMarkers() throws {
+        let table = StandardHuffmanTables.acLuminance
+        let lookup = try #require(ACLookahead(table: table, blockCount: 512))
+        for available in 0...12 { for ffPosition in 0..<8 {
+            for boundary: [UInt8] in [[0xFF, 0], [0xFF, 0xD0], [0xFF, 0xD9], [0xFF]] {
+                for preceding: UInt8 in [0xAA, 0xFE] {
+                    let tail = Array(repeating: preceding, count: ffPosition) + boundary
+                        + Array(repeating: UInt8(0xA5), count: 16)
+                    var fast = BitReader(data: Array(repeating: 0xAA, count: 8) + tail)
+                    var slow = fast
+                    var consume = 64 - available
+                    while consume > 0 {
+                        let count = min(consume, 16)
+                        #expect(try fast.readBits(count) == slow.readBits(count))
+                        consume -= count
+                    }
+                    for remaining in [1, 2, 15, 16, 17, 62, 63] {
+                        var actual = fast, expected = slow
+                        let a = Result {
+                            if let entry = actual.fastDecodeAC(lookup, remaining: remaining) {
+                                return (Int((entry >> 16) & 255), Int32(Int16(truncatingIfNeeded: entry)))
+                            }
+                            return try reference(&actual, table, remaining: remaining)
+                        }
+                        let b = Result { try reference(&expected, table, remaining: remaining) }
+                        switch (a, b) {
+                        case (.success(let x), .success(let y)): #expect(x.0 == y.0 && x.1 == y.1)
+                        case (.failure(let x), .failure(let y)):
+                            #expect(String(describing: x) == String(describing: y))
+                        default: Issue.record("Plain-prefix prefill changed entropy result")
+                        }
+                        actual.alignToByte(); expected.alignToByte()
+                        #expect(actual.byteOffset == expected.byteOffset)
+                    }
+                }
+            }
+        } }
+    }
