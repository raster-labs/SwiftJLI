+    /// AC lookahead alone may accept a partial plain-byte splice. The ordinary
+    /// readBits bulk refill still guarantees enough bits for its pending read.
+    /// Stop before the first possible FF byte; the zero-byte SWAR mask can flag
+    /// an earlier FE neighbour through borrow, which only shortens this prefix.
+    /// Every accepted byte is therefore plain and retains alignToByte's1:1 rewind.
+    @inline(__always)
+    private mutating func prefillACPrefix() -> Bool {
+        guard byteOffset + 8 <= buffer.count else { return false }
+        let word = withExtendedLifetime(data) {
+            UInt64(bigEndian: buffer.loadUnaligned(fromByteOffset: byteOffset, as: UInt64.self))
+        }
+        let inverted = ~word
+        let possibleFF = ((inverted &- 0x0101_0101_0101_0101) & ~inverted & 0x8080_8080_8080_8080)
+        let capacity = (64 - bitsAvailable) >> 3
+        let count = possibleFF == 0 ? capacity : min(capacity, possibleFF.leadingZeroBitCount >> 3)
+        guard count > 0 else { return false }
+        if count == 8 {
+            bitBuffer = word
+        } else {
+            bitBuffer = (bitBuffer &<< (count * 8)) | (word &>> (64 - count * 8))
+        }
+        bitsAvailable += count * 8
+        byteOffset += count
+        return true
+    }
+
     /// Best-effort buffer fill used by the Huffman lookahead paths. Tries the
     /// bulk splice first, then loads whole bytes (resolving `0xFF 0x00` stuffing
     /// exactly as ``loadByte()`` does) until at least `target` bits are buffered,
