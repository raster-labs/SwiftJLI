diff --git a/Sources/SwiftJLI/Native/Entropy/NarrowSequentialCoefficients.swift b/Sources/SwiftJLI/Native/Entropy/NarrowSequentialCoefficients.swift
new file mode 100644
index 0000000..c1700d6
--- /dev/null
+++ b/Sources/SwiftJLI/Native/Entropy/NarrowSequentialCoefficients.swift
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: Apache-2.0
+
+/// Compact storage is restricted to validated sequential 8/12-bit scans. AC
+/// categories are at most 10/14, hence magnitudes are at most 1023/16383. The
+/// caller checks the accumulated DC against ±2^(precision+2) before storing it.
+/// Progressive coefficients and unchecked table values never use this helper.
+enum NarrowSequentialCoefficients {
+    static func accepts(_ table: HuffmanTable, precision: Int) -> Bool {
+        (precision == 8 || precision == 12) && !table.values.isEmpty
+            && table.values.allSatisfy { ($0 & 15) <= (precision == 8 ? 10 : 14) }
+    }
+
+    /// The table was checked by accepts before any scan storage was allocated.
+    /// All 64 slots are cleared before AC decoding. A throw leaves the same
+    /// partial coefficients as the ordinary decoder, represented exactly.
+    static func decodeAC(from reader: inout BitReader, table: HuffmanTable,
+                         lookup: ACLookahead?, into coefficients: UnsafeMutablePointer<Int16>) throws {
+        coefficients.update(repeating: 0, count: 64)
+        var index = 1
+        if let lookup {
+            while index < 64 {
+                if let entry = reader.fastDecodeAC(lookup, remaining: 64 - index) {
+                    let advance = Int((entry >> 16) & 0xFF)
+                    if advance == 0 { break }
+                    index += advance
+                    coefficients[index - 1] = Int16(truncatingIfNeeded: entry)
+                    continue
+                }
+                let symbol = try HuffmanDecoder.decodeSymbol(from: &reader, table: table)
+                if symbol == 0 { break }
+                if symbol == 0xF0 { index += 16; continue }
+                index += Int(symbol >> 4)
+                guard index < 64 else { break }
+                let value = try HuffmanDecoder.decodeValue(from: &reader, category: Int(symbol & 15))
+                guard let narrow = Int16(exactly: value) else {
+                    throw JLIError.decodingFailed("AC coefficient exceeds compact storage")
+                }
+                coefficients[index] = narrow
+                index += 1
+            }
+        } else {
+            while index < 64 {
+                let symbol = try HuffmanDecoder.decodeSymbol(from: &reader, table: table)
+                if symbol == 0 { break }
+                if symbol == 0xF0 { index += 16; continue }
+                index += Int(symbol >> 4)
+                guard index < 64 else { break }
+                let value = try HuffmanDecoder.decodeValue(from: &reader, category: Int(symbol & 15))
+                guard let narrow = Int16(exactly: value) else {
+                    throw JLIError.decodingFailed("AC coefficient exceeds compact storage")
+                }
+                coefficients[index] = narrow
+                index += 1
+            }
+        }
+    }
+
+    /// Consumes every narrow coefficient before its producer may reuse storage.
+    /// The Float conversion and multiplication match the existing Int32 pack:
+    /// every Int16 value is exactly representable in Float. Buffers are disjoint.
+    static func pack(_ coefficients: UnsafePointer<Int16>, quantiser: UnsafePointer<Float>,
+                     into scratch: UnsafeMutablePointer<Float>, blockCount: Int) {
+        guard blockCount > 0 else { return }
+        let rowStride = 8 * blockCount
+        Quantization.inverseZigzagOrder.withUnsafeBufferPointer { order in
+            let invZig = order.baseAddress!
+            for block in 0..<blockCount {
+                let source = coefficients + block * 64
+                for row in 0..<8 {
+                    let destination = scratch + row * rowStride + block * 8
+                    for column in 0..<8 {
+                        let index = row * 8 + column
+                        destination[column] = Float(source[invZig[index]]) * quantiser[index]
+                    }
+                }
+            }
+        }
+    }
+
+    /// Retains the exact DC-only shortcut for all-zero batches in a mixed table.
+    /// On success scratch holds one raw Float per block; all source reads finish
+    /// before this returns. On false no scratch value has been published.
+    static func prepareDCOnly(_ coefficients: UnsafePointer<Int16>, quantiser: UnsafePointer<Float>,
+                              into scratch: UnsafeMutablePointer<Float>, blockCount: Int) -> Bool {
+        guard blockCount > 0 else { return false }
+        for block in 0..<blockCount {
+            var nonzero: Int16 = 0
+            for index in 1..<64 { nonzero |= coefficients[block * 64 + index] }
+            if nonzero != 0 { return false }
+        }
+        let basis = AccelerateDSP.dctMatrix[0]
+        for block in 0..<blockCount {
+            let dequantised = Float(coefficients[block * 64]) * quantiser[0]
+            let first = dequantised * basis
+            scratch[block] = first * basis
+        }
+        return true
+    }
+}
