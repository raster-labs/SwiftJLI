+// SPDX-License-Identifier: Apache-2.0
+import Testing
+@testable import SwiftJLI
+
+@Suite struct NarrowSequentialCoefficientTests {
+    @Test(arguments: [8, 12], [false, true])
+    func allLegalACExtremesMatchWideDecoder(precision: Int, combined: Bool) throws {
+        let limit = precision == 8 ? 10 : 14
+        var bits = [UInt8](repeating: 0, count: 16)
+        let symbols = [UInt8(0), 0xF0] + (1...limit).map { UInt8($0) }
+        bits[3] = UInt8(symbols.count)
+        let table = HuffmanTable(bits: bits, values: symbols)
+        #expect(NarrowSequentialCoefficients.accepts(table, precision: precision))
+        let lookup = combined ? try #require(ACLookahead(table: table, blockCount: 1024)) : nil
+        for category in 1...limit { for sign: Int32 in [-1, 1] {
+            var expected = [Int32](repeating: 0, count: 64)
+            for index in 1..<64 { expected[index] = sign * ((1 << category) - 1) }
+            var writer = BitWriter()
+            HuffmanEncoder.encodeAC(expected, table: table, writer: &writer)
+            writer.flush()
+            var wideReader = BitReader(data: writer.data), narrowReader = wideReader
+            var wide = [Int32](repeating: 123456, count: 64)
+            var narrow = [Int16](repeating: 12345, count: 70)
+            try wide.withUnsafeMutableBufferPointer { output in
+                if let lookup { try HuffmanDecoder.decodeAC(from: &wideReader, table: table, lookup: lookup, into: output) }
+                else { try HuffmanDecoder.decodeAC(from: &wideReader, table: table, into: output) }
+            }
+            try narrow.withUnsafeMutableBufferPointer { output in
+                try NarrowSequentialCoefficients.decodeAC(from: &narrowReader, table: table,
+                    lookup: lookup, into: output.baseAddress! + 3)
+            }
+            #expect(wide == expected)
+            #expect(narrow[3..<67].map(Int32.init) == expected)
+            #expect(narrow.prefix(3).allSatisfy { $0 == 12345 } && narrow.suffix(3).allSatisfy { $0 == 12345 })
+            wideReader.alignToByte(); narrowReader.alignToByte()
+            #expect(wideReader.byteOffset == narrowReader.byteOffset)
+        } }
+    }
+
+    @Test func invalidCategoriesAndTruncatedEntropyDoNotPublishNarrowValues() throws {
+        var bits = [UInt8](repeating: 0, count: 16); bits[0] = 1
+        let tooWide = HuffmanTable(bits: bits, values: [0x0F])
+        #expect(!NarrowSequentialCoefficients.accepts(tooWide, precision: 12))
+        #expect(!NarrowSequentialCoefficients.accepts(StandardHuffmanTables.acLuminance, precision: 7))
+        let table = StandardHuffmanTables.acLuminance
+        for combined in [false, true] {
+            let lookup = combined ? try #require(ACLookahead(table: table, blockCount: 1024)) : nil
+            for bytes in [[UInt8](), [0xFF], [0xFF, 0xD0], [0x12, 0x37]] {
+                var wideReader = BitReader(data: bytes), narrowReader = wideReader
+                var wide = [Int32](repeating: 123456, count: 64)
+                var narrow = [Int16](repeating: 12345, count: 64)
+                let wideResult = Result { try wide.withUnsafeMutableBufferPointer { output in
+                    if let lookup { try HuffmanDecoder.decodeAC(from: &wideReader, table: table, lookup: lookup, into: output) }
+                    else { try HuffmanDecoder.decodeAC(from: &wideReader, table: table, into: output) }
+                } }
+                let narrowResult = Result { try narrow.withUnsafeMutableBufferPointer { output in
+                    try NarrowSequentialCoefficients.decodeAC(from: &narrowReader, table: table,
+                        lookup: lookup, into: output.baseAddress!)
+                } }
+                switch (wideResult, narrowResult) {
+                case (.failure(let a), .failure(let b)): #expect(String(describing: a) == String(describing: b))
+                case (.success, .success): break
+                default: Issue.record("Narrow entropy handling diverged")
+                }
+                #expect(narrow.map(Int32.init) == wide)
+                wideReader.alignToByte(); narrowReader.alignToByte()
+                #expect(wideReader.byteOffset == narrowReader.byteOffset)
+            }
+        }
+    }
+
+    @Test func narrowPackingAndCanonicalTransformsKeepRawFloatBits() {
+        for count in [1, 7, 8, 63, 226, 1023, 1024] { for dcOnly in [false, true] {
+            let extremes: [Int16] = [-16384, -16383, -1024, -1, 0, 1, 1024, 16383, 16384]
+            var narrow = [Int16](repeating: 0, count: count * 64)
+            for block in 0..<count {
+                narrow[block * 64] = extremes[block % extremes.count]
+                if !dcOnly { for index in 1..<64 {
+                    narrow[block * 64 + index] = Int16((block * 97 + index * 151) % 32767 - 16383)
+                } }
+            }
+            let wide = narrow.map(Int32.init), quantiser: [Float] = (0..<64).map { [1, 3, 255, 65535][$0 % 4] }
+            var expected = [Float](repeating: 123456, count: narrow.count)
+            var actual = expected, scratch = expected
+            wide.withUnsafeBufferPointer { w in
+                narrow.withUnsafeBufferPointer { n in
+                    quantiser.withUnsafeBufferPointer { q in
+                        expected.withUnsafeMutableBufferPointer { e in
+                            actual.withUnsafeMutableBufferPointer { a in
+                                scratch.withUnsafeMutableBufferPointer { s in
+                                    AccelerateDSP.packDequantizedDCTBatch(zigzag: w.baseAddress!,
+                                        quantTable: q.baseAddress!, scratch: e.baseAddress!, blockCount: count)
+                                    NarrowSequentialCoefficients.pack(n.baseAddress!, quantiser: q.baseAddress!,
+                                        into: a.baseAddress!, blockCount: count)
+                                    #expect(a.indices.allSatisfy { a[$0].bitPattern == e[$0].bitPattern })
+                                    if dcOnly {
+                                        var prepared = [Float](repeating: 123456, count: count)
+                                        prepared.withUnsafeMutableBufferPointer { p in
+                                            #expect(NarrowSequentialCoefficients.prepareDCOnly(n.baseAddress!,
+                                                quantiser: q.baseAddress!, into: p.baseAddress!, blockCount: count))
+                                            #expect(AccelerateDSP.prepareDCOnlyDCTBatch(zigzag: w.baseAddress!,
+                                                quantTable: q.baseAddress!, scratch: s.baseAddress!, blockCount: count))
+                                            #expect(p.indices.allSatisfy { p[$0].bitPattern == s[$0].bitPattern })
+                                        }
+                                    }
+                                    // The same canonical GEMM dimensions consume identical inputs.
+                                    AccelerateDSP.inverseDCTBatchPacked(output: s.baseAddress!, scratch: e.baseAddress!, blockCount: count)
+                                    let reference = Array(s)
+                                    AccelerateDSP.inverseDCTBatchPacked(output: s.baseAddress!, scratch: a.baseAddress!, blockCount: count)
+                                    #expect(reference.indices.allSatisfy { reference[$0].bitPattern == s[$0].bitPattern })
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        } }
+    }
+}
