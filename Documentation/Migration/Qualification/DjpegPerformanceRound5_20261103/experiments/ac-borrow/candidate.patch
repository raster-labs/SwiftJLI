@@ -324,13 +324,26 @@ struct BitReader {
     /// AC decoder stops after the Huffman symbol in that case.
     @inline(__always)
     mutating func fastDecodeAC(_ table: ACLookahead, remaining: Int) -> UInt32? {
+        table.entries.withUnsafeBufferPointer { entries in
+            guard entries.count == ACLookahead.count, let base = entries.baseAddress else { return nil }
+            return fastDecodeAC(base, remaining: remaining)
+        }
+    }
+
+    /// The caller must keep exactly ACLookahead.count (8192) initialised entries
+    /// from an ACLookahead table alive and immutable for this synchronous call.
+    /// The pointer is read only and never retained. Prefix masking below proves
+    /// the index is in 0..<8192, allowing a block-wide borrow to validate capacity
+    /// once rather than repeating the Array bounds check for every coefficient.
+    @inline(__always)
+    mutating func fastDecodeAC(_ entries: UnsafePointer<UInt32>, remaining: Int) -> UInt32? {
         if bitsAvailable < ACLookahead.bits, !bulkRefill() { fillBuffer(upTo: 8) }
         guard bitsAvailable >= ACLookahead.bits else { return nil }
         // Reader mutations bound the accumulator to 0...64 valid bits. After
         // the guard this shift is 0...51, so the masked form has identical
         // semantics without a general signed-width check per coefficient.
         let prefix = Int((bitBuffer &>> (bitsAvailable - ACLookahead.bits)) & UInt64(ACLookahead.count - 1))
-        let entry = table.entries[prefix]
+        let entry = entries[prefix]
         guard entry != 0, Int((entry >> 16) & 0xFF) <= remaining else { return nil }
         bitsAvailable -= Int(entry >> 24)
         return entry
