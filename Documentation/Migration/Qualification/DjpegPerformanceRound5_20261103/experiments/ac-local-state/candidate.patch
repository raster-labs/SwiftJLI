+    /// Decodes one AC block while the accumulator and its bit count stay local
+    /// across coefficient stores. The caller must retain a writable, initialised
+    /// 64-element coefficient borrow throughout this synchronous call. It may
+    /// not alias this reader, its compressed input, or either Huffman table.
+    /// Neither the pointer nor a reader borrow escapes this method.
+    mutating func decodeACBlock(table: HuffmanTable, lookup: ACLookahead,
+                                coefficients: UnsafeMutablePointer<Int32>) throws {
+        coefficients.update(repeating: 0, count: 64)
+        var accumulator = bitBuffer, available = bitsAvailable
+        // All exits, including an entropy error after a partially consumed
+        // symbol, publish the exact logical bit state back to the reader.
+        defer { bitBuffer = accumulator; bitsAvailable = available }
+        var index = 1
+        while index < 64 {
+            if available < ACLookahead.bits {
+                bitBuffer = accumulator; bitsAvailable = available
+                if !bulkRefill() { fillBuffer(upTo: 8) }
+                accumulator = bitBuffer; available = bitsAvailable
+            }
+            if available >= ACLookahead.bits {
+                // available is 13...64, so the masked shift is 0...51.
+                // Keep the checked Array access and all original run guards.
+                let prefix = Int((accumulator &>> (available - ACLookahead.bits))
+                    & UInt64(ACLookahead.count - 1))
+                let entry = lookup.entries[prefix]
+                let advance = Int((entry >> 16) & 0xFF)
+                if entry != 0, advance <= 64 - index {
+                    available -= Int(entry >> 24)
+                    if advance == 0 { break }
+                    index += advance
+                    coefficients[index - 1] = Int32(Int16(truncatingIfNeeded: entry))
+                    continue
+                }
+            }
+            // Only the existing refill/fallback routines mutate byteOffset.
+            // Reload local state even if a routine throws after consuming input;
+            // this inner defer runs before the outer state-publication defer.
+            bitBuffer = accumulator; bitsAvailable = available
+            do {
+                defer { accumulator = bitBuffer; available = bitsAvailable }
+                let symbol = try HuffmanDecoder.decodeSymbol(from: &self, table: table)
+                if symbol == 0x00 { break }
+                if symbol == 0xF0 { index += 16; continue }
+                index += Int(symbol >> 4)
+                guard index < 64 else { break }
+                coefficients[index] = try HuffmanDecoder.decodeValue(from: &self,
+                    category: Int(symbol & 0x0F))
+                index += 1
+            }
+        }
+    }
+
     /// Best-effort buffer fill used by the Huffman lookahead paths. Tries the
     /// bulk splice first, then loads whole bytes (resolving `0xFF 0x00` stuffing
     /// exactly as ``loadByte()`` does) until at least `target` bits are buffered,
