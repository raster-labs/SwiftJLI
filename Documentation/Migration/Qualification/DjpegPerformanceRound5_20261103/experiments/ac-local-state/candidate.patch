+    func invalidDestinationIsRejectedBeforeWriting(combined: Bool) throws {
+        var reader = BitReader(data: Array(repeating: 0xAA, count: 16))
+        let table = StandardHuffmanTables.acLuminance
+        let lookup = try #require(ACLookahead(table: table, blockCount: 512))
         var output = [Int32](repeating: 919, count: 63)
