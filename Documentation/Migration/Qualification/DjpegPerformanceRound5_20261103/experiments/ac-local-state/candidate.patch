             try output.withUnsafeMutableBufferPointer {
-                try HuffmanDecoder.decodeAC(from: &reader, table: StandardHuffmanTables.acLuminance, into: $0)
+                if combined {
+                    try HuffmanDecoder.decodeAC(from: &reader, table: table, lookup: lookup, into: $0)
+                } else {
+                    try HuffmanDecoder.decodeAC(from: &reader, table: table, into: $0)
+                }
             }
         }
         #expect(output.allSatisfy { $0 == 919 })
+        #expect(reader.byteOffset == 0)
+    }
+
+    @Test func localAccumulatorPreservesEveryPrefixAndPartialFailureCursor() throws {
+        let tables = [StandardHuffmanTables.acLuminance, StandardHuffmanTables.acChrominance,
+            HuffmanTable(bits: [0, 0, 0, 15] + Array(repeating: 0, count: 12),
+                values: (0..<13).map { UInt8($0 << 4) } + [0x01, 0xF0])]
+        var successes = 0, failures = 0
+        for table in tables {
+            let lookup = try #require(ACLookahead(table: table, blockCount: 512))
+            for offset in 0..<8 { for prefix in 0..<ACLookahead.count {
+                var writer = BitWriter(estimatedMaxSize: 32)
+                writer.writeBits(0, count: offset)
+                writer.writeBits(UInt32(prefix), count: ACLookahead.bits)
+                for tail in [UInt32(0xA55A), 0x1234, 0x6789, 0x90AB] {
+                    writer.writeBits(tail, count: 16)
+                }
+                writer.flush()
+                var reference = BitReader(data: writer.data), local = reference
+                _ = try reference.readBits(offset); _ = try local.readBits(offset)
+                var expected = [Int32](repeating: 919, count: 64)
+                var actual = [Int32](repeating: 919, count: 71)
+                let lhs = Result { try HuffmanDecoder.decodeAC(from: &reference, table: table, into: &expected) }
+                let rhs = Result { try pointerDecode(&local, table: table, lookup: lookup, output: &actual) }
+                switch (lhs, rhs) {
+                case (.success, .success): successes += 1
+                case (.failure(let a), .failure(let b)):
+                    failures += 1
+                    #expect(String(describing: a) == String(describing: b))
+                default: Issue.record("Local accumulator changed block completion or failure")
+                }
+                #expect(Array(actual[3..<67]) == expected)
+                #expect(actual.prefix(3).allSatisfy { $0 == 919 })
+                #expect(actual.suffix(4).allSatisfy { $0 == 919 })
+                var referencePosition = reference, localPosition = local
+                referencePosition.alignToByte(); localPosition.alignToByte()
+                #expect(localPosition.byteOffset == referencePosition.byteOffset)
+                // Check the unaligned remainder after both successful and
+                // partially failing blocks, exposing stale-state defer bugs.
+                let expectedNext = Result { try reference.readBits(8) }
+                let actualNext = Result { try local.readBits(8) }
+                switch (expectedNext, actualNext) {
+                case (.success(let a), .success(let b)): #expect(a == b)
+                case (.failure(let a), .failure(let b)):
+                    #expect(String(describing: a) == String(describing: b))
+                default: Issue.record("Local accumulator changed post-block entropy")
+                }
+            } }
+        }
+        #expect(successes > 0 && failures > 0)
     }
