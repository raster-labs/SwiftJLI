@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: Apache-2.0
+import Testing
+@testable import SwiftJLI
+
+@Suite struct VectorCompactionTests {
+    private func reference(_ pixels: UnsafeMutableBufferPointer<Float>, precision: Int,
+                           bytesPerSample: Int) throws {
+        let maximum = Float((1 << precision) - 1)
+        let bytes = UnsafeMutableRawBufferPointer(pixels)
+        for index in pixels.indices {
+            let sample = pixels[index]
+            guard sample.isFinite else { throw JLIError.decodingFailed("Non-finite reconstructed sample") }
+            let value = UInt16(max(0, min(maximum, sample)).rounded(.toNearestOrAwayFromZero))
+            bytes[index * bytesPerSample] = UInt8(truncatingIfNeeded: value)
+            if bytesPerSample == 2 { bytes[index * 2 + 1] = UInt8(value >> 8) }
+        }
+    }
+
+    @Test(arguments: [(8, 1), (8, 2), (12, 2)])
+    func everyHalfIntegerNeighbourTailAndAlignmentMatchesScalar(format: (Int, Int)) throws {
+        let (precision, bps) = format, maximum = (1 << precision) - 1
+        var samples: [Float] = [-.greatestFiniteMagnitude, -.leastNonzeroMagnitude, -0.0,
+                                0, .leastNonzeroMagnitude, .greatestFiniteMagnitude]
+        for integer in 0...maximum {
+            let value = Float(integer), half = value + 0.5
+            samples += [value.nextDown, value, value.nextUp, half.nextDown, half, half.nextUp]
+        }
+        for prefix in 0..<4 { for tail in 0..<4 {
+            let count = samples.count - tail
+            let guardValue: Float = 987654
+            var expected = [Float](repeating: guardValue, count: prefix)
+                + samples.prefix(count) + [Float](repeating: guardValue, count: 5)
+            var actual = expected
+            try expected.withUnsafeMutableBufferPointer {
+                try reference(.init(rebasing: $0[prefix..<(prefix + count)]), precision: precision, bytesPerSample: bps)
+            }
+            try actual.withUnsafeMutableBufferPointer {
+                try ParallelSequentialGreyscaleDecoder.compactPixelsInPlace(
+                    .init(rebasing: $0[prefix..<(prefix + count)]), precision: precision,
+                    bytesPerSample: bps, floatOutput: false)
+            }
+            expected.withUnsafeBytes { e in actual.withUnsafeBytes { #expect($0.elementsEqual(e)) } }
+        } }
+        for count in 0..<9 {
+            var actual = Array(samples.prefix(count)), expected = actual
+            try expected.withUnsafeMutableBufferPointer { try reference($0, precision: precision, bytesPerSample: bps) }
+            // Empty arrays may supply a nil pointer and retain the existing rejection.
+            if count > 0 {
+                try actual.withUnsafeMutableBufferPointer {
+                    try ParallelSequentialGreyscaleDecoder.compactPixelsInPlace($0,
+                        precision: precision, bytesPerSample: bps, floatOutput: false)
+                }
+                expected.withUnsafeBytes { e in actual.withUnsafeBytes { #expect($0.elementsEqual(e)) } }
+            }
+        }
+    }
+
+    @Test(arguments: [(8, 1), (8, 2), (12, 2)])
+    func nonFiniteLanesPreserveExactPartialFailureBoundary(format: (Int, Int)) throws {
+        let (precision, bps) = format
+        for invalid in [Float.nan, -.infinity, .infinity, Float(bitPattern: 0xFFC0_0001)] {
+            for position in [0, 1, 2, 3, 4, 5, 6, 7, 4095, 4096, 4097, 4098, 4099] {
+                var expected = [Float](repeating: 123.5, count: 4103)
+                expected[position + 1] = invalid
+                var actual = expected
+                let e = Result { try expected.withUnsafeMutableBufferPointer {
+                    try reference(.init(rebasing: $0[1..<4102]), precision: precision, bytesPerSample: bps)
+                } }
+                let a = Result { try actual.withUnsafeMutableBufferPointer {
+                    try ParallelSequentialGreyscaleDecoder.compactPixelsInPlace(.init(rebasing: $0[1..<4102]),
+                        precision: precision, bytesPerSample: bps, floatOutput: false)
+                } }
+                switch (e, a) {
+                case (.failure(let e), .failure(let a)): #expect(String(describing: e) == String(describing: a))
+                default: Issue.record("Non-finite compaction unexpectedly succeeded")
+                }
+                expected.withUnsafeBytes { e in actual.withUnsafeBytes { #expect($0.elementsEqual(e)) } }
+            }
+        }
+    }
+}
