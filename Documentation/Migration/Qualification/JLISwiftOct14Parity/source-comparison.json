  "findings": [
    {
      "area": "Sequential DHT table scope",
      "classification": "confirmed source mismatch; candidate fix pending",
      "evidence": "MarkerReader retains SOS Huffman snapshots and JPEGDCTValidation validates them; sequential JLIDecoder selects final parser dictionaries. Envelope accepts later DHT. Progressive and lossless already use scan snapshots. New predecessor caller-core selects per-scan descriptors; its legacy owning path still uses globals."
    },
    {
      "area": "SOF/SOS/DQT/DHT/DRI segment admission",
      "classification": "equivalent public guards already present",
      "evidence": "JPEGEnvelope validates each declared segment extent, exact component counts and DRI length before native parser. It enforces table ID/class and canonical counts."
    },
    {
      "area": "Post-SOS DQT/DRI and multiple sequential scans",
      "classification": "explicit supported-capability difference",
      "evidence": "JPEGEnvelope rejects these inputs; MIGRATION documents limitation. New predecessor caller-core supports them. No silent decoding with final global state is admitted."
    },
    {
      "area": "Undersampled luma and XYB expansion",
      "classification": "explicit supported-capability difference",
      "evidence": "JPEGDCTValidation permits sampling variation only in first colour component; others 1x1, and XYB requires all 1x1. New predecessor expansion is relevant to its additional supported profiles."
    },
    {
      "area": "Cumulative DC and magnitude bounds",
      "classification": "equivalent public/native guards already present",
      "evidence": "Sequential and progressive decoder use Int64 accumulation and bounded precision; DCT validation limits categories; BitReader checks width <=16 before shifts."
    },
    {
      "area": "Caller-workspace API, scalar failure records and borrowed spans",
      "classification": "predecessor-specific architecture/API",
      "evidence": "New JLICoreOutcome and caller-owned arenas have different ownership/capacity/metadata contract; SwiftJLI owning storage and executor remain intact. No zero-total-allocation equivalence claim."
    },
    {
      "area": "ICC profile literal representation",
      "classification": "verified byte-equivalent",
      "evidence": "Independent standalone comparison: 728 bytes identical; icc-parity.swift and icc-inputs.json retain runner and source hashes."
    },
    {
      "area": "Fixed constants, IDCT/colour refactor",
      "classification": "caller-core allocation qualification refactor",
      "evidence": "Tuple/literal constants retain values; supplied reconstruction constants and SIMD/scalar paths replace external DSP workspace for new caller-core. No demonstrated sample defect in existing supported SwiftJLI path."
    },
    {
      "area": "Cancellation and joined lifetime",
      "classification": "SwiftJLI equivalent policy already present",
      "evidence": "NativeOperation checkpoints in parser/entropy boundary and row loops, scoped borrows and joined workers; new predecessor explicit callbacks differ from SwiftJLI task/executor policy."
    }
