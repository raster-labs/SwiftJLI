+                blocksPerRow: columns, blockRows: rows, precision: 12, restartInterval: interval,
+                batchBlocks: window) { coefficients, first in
+                #expect(first == collected.count / 64)
+                #expect(coefficients.count <= window * 64)
+                collected.append(contentsOf: coefficients)
+            }
+            #expect(collected == expected)
+            try reader.skipRestartMarker(expectedIndex: 5)
+            #expect(try reader.readBits(8) == 0xA3)
+        }
+    }
